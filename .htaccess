# Lenka Graf – statický web (Constructiva Visuals)
# Konfigurace pro Apache 2.4 (Zoner / CZECHIA.COM). Nahrazuje původní WordPress na www.lenkagraf.com.
# Podrobný popis pravidel: DOKUMENTACE.pdf, kapitola „Konfigurace serveru“.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # skryté soubory (.htaccess, stav FTP deploye apod.) nejsou veřejné; /.well-known zůstává kvůli ověření certifikátu
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F]

  # lenkagraf.com -> https://www.lenkagraf.com (jedním přesměrováním pro http i https)
  RewriteCond %{HTTP_HOST} ^lenkagraf\.com$ [NC]
  RewriteRule ^(.*)$ https://www.lenkagraf.com/$1 [R=301,L]

  # http -> https; pokud to už dělá hosting, pravidlo se neuplatní (za proxy bere v úvahu X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # staré adresy WordPressu -> nové stránky
  RewriteRule ^z-medii/?$ /rozhovory.html [R=301,L]
  RewriteRule ^en/from-the-media/?$ /rozhovory.html [R=301,L]
  RewriteRule ^de/medien-news/?$ /rozhovory.html [R=301,L]
  RewriteRule ^(en|de)(/.*)?$ / [R=301,L]

  # staré odkazy na výstřižky z médií -> assets/media/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+)$ /assets/media/$1 [R=301,L]
</IfModule>

# cache: HTML vždy čerstvé, ostatní soubory týden, písmo rok
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
