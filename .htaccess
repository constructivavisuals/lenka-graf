# Lenka Graf – statický web (Constructiva Visuals)
# Nahrazuje původní WordPress na www.lenkagraf.com. Platí pro Apache (Zoner / CZECHIA.COM).
# Přesměrování http -> https zajišťuje hosting, tady se neřeší.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # lenkagraf.com -> www.lenkagraf.com (dřív to dělal WordPress)
  RewriteCond %{HTTP_HOST} ^lenkagraf\.com$ [NC]
  RewriteRule ^(.*)$ https://www.lenkagraf.com/$1 [R=301,L]

  # staré adresy WordPressu -> nové stránky
  RewriteRule ^z-medii/?$ /rozhovory.html [R=301,L]
  RewriteRule ^en/from-the-media/?$ /rozhovory.html [R=301,L]
  RewriteRule ^de/medien-news/?$ /rozhovory.html [R=301,L]
  RewriteRule ^(en|de)(/.*)?$ / [R=301,L]

  # staré odkazy na výstřižky z médií -> assets/media/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+)$ /assets/media/$1 [R=301,L]
</IfModule>

# cache: HTML vždy čerstvé, ostatní soubory týden, písmo rok
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
